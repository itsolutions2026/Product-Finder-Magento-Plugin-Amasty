    <script type="text/javascript">
        require(['jquery', 'Amasty_Finder/js/amfinder'], function ($) {
            var finderConfig = <?= $block->getJsonConfig(); ?>;

            $("#" + finderConfig.containerId).amfinder(finderConfig);

            function _onSwitchType() {

                let current_URL = new URL(window.location.href);
                let search_params = current_URL.searchParams;

                search_params.set('ktype', $(this).data('ktype'));
                current_URL.search = search_params.toString();

                window.location.href = current_URL.toString();
            }

            $("#" + finderConfig.containerId).on('click', "a.switch_searchType", _onSwitchType)
        });
    </script>
