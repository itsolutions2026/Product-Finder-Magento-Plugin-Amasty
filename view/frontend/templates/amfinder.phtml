    <script type="text/javascript">
        require(['jquery', 'Amasty_Finder/js/amfinder'], function ($) {
            var finderConfig = <?= $block->getJsonConfig(); ?>;

            $("#" + finderConfig.containerId).amfinder(finderConfig);

            let labels = {
                'search_db' : 'Searching Database...',
                'rego_not_found' : 'Registration Number Not Found, please enter your VIN number instead.',
                'vim_not_found' : 'Vin Number Not Found, please use the Make/Model Search.',
                'multi_result' : 'Search resulted in multiple options. Please select correct vehicle below:',
                'single_result' : 'Search resulted in one option. Select it below:'
            }

            let ajax;
            let url = "<?php echo $block->getActionKtypeUrl(); ?>";
            let ktype_item_template = '<div class="ktype-item" data-ktypeNum="{{ktype}}" data-ktypeMetaBrand="{{ktype_meta_brand}}" data-ktypeMetaModel="{{ktype_meta_model}}" data-ktypeMetaProperty="{{ktype_meta_property}}">' +
                '<div class="ktype-item-title">{{shortNameCar}}</div> ' +
                '<div class="ktype-item-detail"> ' +
                '<div>{{bodyCar}}</div> ' +
                '<div>{{fuelSystem}}</div> ' +
                '<div>{{driveType}}</div> ' +
                '<div>{{ccmCar}} ccm</div> ' +
                '<div>{{kwCar}} kw</div> ' +
                '<div>{{hpCar}} hp</div> ' +
                '<div>{{listEngines}}</div></div></div>';

            function _onSwitchType() {
                let current_URL = new URL(window.location.href);
                let search_params = current_URL.searchParams;

                search_params.set('ktype', $(this).data('ktype'));
                current_URL.search = search_params.toString();

                window.location.href = current_URL.toString();
            }

            function load_start() {
                $('div.ktype-label').text(labels.search_db);
                $('div.ktype-list').show();
                $('form.vin-rego-form').hide();
                show_loading_animation();
            }

            function display_no_result(searchType){
                if(searchType === 'vin_search'){
                    $('div.ktype-label').text(labels.vim_not_found);
                }
                else if (searchType === 'rego_search') {
                    $('div.ktype-label').text(labels.rego_not_found);
                }
                $('div.ktype-list').show();
                $('form.vin-rego-form').hide();
                remove_loading_animation()
            }

            function remove_loading_animation(){
                $('.amfinder-common-wrapper .loading-mask').hide();
            }

            function show_loading_animation(){
                $('.amfinder-common-wrapper .loading-mask').show();
            }

            function _ktypeSearch(event) {
                event.preventDefault();
                let search_type = $(this).data('title');

                if($(this).prop('tabindex') != "1"){
                    search_type === "vin_search"? $("button#rego_search").click():$("button#vin_search").click();
                    return false;
                }

                let validation = true;
                let state = $("select[name='ktype_state']").val();



                let regoNumber = $("input[name='rego_num']").val();
                let vinNumber = $("input[name='vin_num']").val();

                if (search_type === "vin_search") {
                    if (!vinNumber || !vinNumber.match(/^( ?[a-zA-Z0-9]){17}$/)) {
                        $("._vin_message").show();
                        validation = false;
                    }
                } else if (search_type === "rego_search") {

                    if (!state || state === "0") {
                        validation = false;
                        $(".select_error_message").show();
                    }

                    if (!regoNumber || !regoNumber.match(/^( ?[a-zA-Z0-9]){1,7}$/)) {
                        $("._rego_message").show();
                        validation = false;
                    }

                } else {
                    validation = false;
                }

                if (validation) {
                    load_start()
                    ajax = $.ajax({
                        url: url,
                        type: "POST",
                        data: {
                            state: state,
                            search_type: search_type,
                            value: search_type === "vin_search" ? vinNumber : regoNumber
                        },
                        cache: true,
                        success: function (res) {
                            try {
                                let response = JSON.parse(res);
                                console.log(response)
                                if(response && response.status && response.count > 0){

                                    if (response.count > 1){
                                        $('div.ktype-label').text(labels.multi_result);
                                    }
                                    else{
                                        $('div.ktype-label').text(labels.single_result);
                                    }

                                    $('.ktype-list-wrapper').html('');

                                    response.cars.forEach((item)=>{
                                        let replaced = ktype_item_template.replace( /\{{(.*?)\}}/g, (_, innnerText) => {

                                            switch(innnerText){
                                                case 'ktype_meta_brand':
                                                     return item.modelCar + ' - ' + item.bodyCar + '|' + item.fuelSystem + '|' + item.driveType
                                                case 'ktype_meta_model':
                                                    return item.typeCar + ' [' + item.typeFromYearCar.slice(0,4) + ' - ' + item.typeToYearCar.slice(0,4) + ']'
                                                case 'ktype_meta_property':
                                                    return item.ccmCar + ' ccm, ' + item.kwCar + ' kw, ' + item.hpCar + ' hp'
                                            }
                                            return item[innnerText]? item[innnerText] : ''
                                        })
                                        $('.ktype-list-wrapper').append(replaced);
                                        remove_loading_animation();
                                    })
                                } else {
                                    throw new Error('no_result')
                                }
                            } catch (e) {
                                console.log(e)
                                display_no_result(search_type)
                            }
                        },
                        error: function (error) {
                            if(error.statusText !== 'abort')
                            display_no_result(search_type)
                        }
                    })
                }
                else{
                    return false
                }
            }

            function _clearKtypeErrorFields() {
                $(".select_error_message").hide();
                $("._vin_message").hide();
                $("._rego_message").hide();
                $("div.dropdown-element button").prop('tabindex', "-1")
                $(this).parent().closest("li.am-item").find("button").prop('tabindex', 1)
            }

            $(document).on('click', "button#rego_search, button#vin_search", _ktypeSearch)

            $(document).on('change', "select[name='ktype_state']", _clearKtypeErrorFields)

            $(document).on('input', "input[name='rego_num'], input[name='vin_num']", _clearKtypeErrorFields)

            $(document).on('click', "div.search-result button#clear_filter", function(){
                $("form.ktype-search button[name='reset']").click();
            })

            $(document).on('click', "div.search-result button#change_vehicle", function(){
                $("div.search-result").hide();
                $('form.vin-rego-form').show();
            })

            $(document).on('click', "div.close-ktype-list", function(){
                $('div.ktype-list-wrapper').html('')
                $('div.ktype-list').hide();
                $('form.vin-rego-form').show();
                if(ajax) ajax.abort();
            })

            $(document).on('click', "div.ktype-item", function(){

                let ktypeNum = $(this).data('ktypenum');
                let ktypeMetaBrand = $(this).data('ktypemetabrand');
                let ktypeMetaModel = $(this).data('ktypemetamodel');
                let ktypeMetaProperty = $(this).data('ktypemetaproperty');

                let exists = $("form.ktype-search select.amfinder-select option:contains(" + ktypeNum + ")").length !== 0;

                if(exists){
                    let option_val = $("form.ktype-search select.amfinder-select option:contains(" + ktypeNum + ")").val()
                    $("form.ktype-search select.amfinder-select").val(option_val).trigger("chosen:updated");
                    $("form.ktype-search input[name='ktypeNum']").val(ktypeNum)
                    $("form.ktype-search input[name='ktypeMetaBrand']").val(ktypeMetaBrand)
                    $("form.ktype-search input[name='ktypeMetaModel']").val(ktypeMetaModel)
                    $("form.ktype-search input[name='ktypeMetaProperty']").val(ktypeMetaProperty)
                    $("form.ktype-search").submit();
                }else{
                    $('div.ktype-list').hide();
                    $('form.ktype-search span.car-info').text(ktypeMetaBrand);
                    $('form.ktype-search').show();

                }
            })

            $("#" + finderConfig.containerId).on('click', "a.switch_searchType", _onSwitchType)
        });
    </script>
    <br/>

<?php } else if ($block->getFinder()->getName() !== "ktypeSearch" && !$block->isKtype()) {
